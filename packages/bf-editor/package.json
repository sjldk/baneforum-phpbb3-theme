{
	"name": "bf-editor",
	"version": "0.1.0",
	"description": "Rich text editor as web components, built on ProseMirror. Part of Baneforum.",
	"type": "module",
	"license": "MIT",
	"private": true,
	"main": "dist/bf-editor.js",
	"exports": {
		".": "./dist/bf-editor.js",
		"./bf-render.css": "./dist/bf-render.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.mjs",
		"test": "node --test \"test/**/*.test.js\"",
		"lint": "biome lint ../.. && eslint .",
		"format": "eslint --fix . ; biome format --write ../..",
		"format:check": "biome format ../..",
		"typecheck": "tsc --noEmit",
		"check": "biome check ../.. && eslint . && tsc --noEmit && node --test \"test/**/*.test.js\"",
		"style": "eslint ."
	},
	"dependencies": {
		"prosemirror-commands": "^1.7.1",
		"prosemirror-dropcursor": "^1.8.2",
		"prosemirror-gapcursor": "^1.3.2",
		"prosemirror-history": "^1.4.1",
		"prosemirror-inputrules": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.1",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-tables": "^1.8.5",
		"prosemirror-transform": "^1.10.4",
		"prosemirror-view": "^1.40.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"esbuild": "^0.25.0",
		"eslint": "^10.13.0",
		"jsdom": "^26.1.0",
		"typescript": "^5.9.0"
	}
}
